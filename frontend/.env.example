# Server-side only. Copy to .env.local and fill in. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Where the typed API client sends requests. Default is the built-in mock at /api/mock.
NEXT_PUBLIC_API_BASE_URL=/api/mock

# Server-side address of platform-backend (compose default). Use http://localhost:<port> for local runs.
BACKEND_URL=http://platform-backend:3000
